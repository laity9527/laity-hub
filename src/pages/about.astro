---
// 关于 Laity
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="关于 Laity | 独立开发厂牌" description="Laity Studio 是一个独立开发厂牌：外行造世界，用 AI 把想法直接做成上线作品。">
	<div class="container">

		<header>
			<h1>关于 <span class="highlight">Laity</span></h1>
			<p class="subtitle">外行造世界</p>
		</header>

		<main>
			<p class="lead">Laity Studio 是一个<span class="highlight">独立开发厂牌</span>，致力于利用 AI 和现代 Web 技术，将想法直接转化为上线作品。</p>
		</main>

	</div>
</BaseLayout>

<style>
	/* 正文区 */
	main { max-width: 640px; margin: 0 auto; text-align: center; }
	.lead { font-size: 1.125rem; color: #d4d4d8; line-height: 1.8; }
</style>
