---
// Laity 主站
import Base from '../layouts/Base.astro';
import { fetchLatestTracks } from '../lib/tracks';
import projects from '../data/projects.json';

const statusLabel: Record<string, string> = { live: 'Live', wip: 'WIP' };
const isExternalUrl = (url: string) => /^https?:\/\//.test(url);

const tracks = await fetchLatestTracks('https://build.laity.work/rss.xml', 3);
---

<Base title="Laity Studio | 外行造世界">
	<div class="container">

		<!-- 1. 头部区 -->
		<header>
			<h1>Laity<span class="highlight">.</span></h1>
			<p class="subtitle">我是外行，但我用 AI 构建世界。<br>不囤想法，直接上线。</p>
		</header>

		<!-- 2. 项目矩阵区 -->
		<main class="grid">
			{projects.map((project) => (
				<a
					href={project.url}
					class:list={['card', project.featured && 'col-span-2 card-main']}
					target={isExternalUrl(project.url) ? '_blank' : undefined}
					rel={isExternalUrl(project.url) ? 'noopener' : undefined}
				>
					<div style="display: flex; justify-content: space-between; align-items: start;">
						<h3>{`${project.icon} ${project.title}`}</h3>
						<span class={`tag tag-${project.status}`}>
							<span class="dot"></span>{statusLabel[project.status]}
						</span>
					</div>
					<p style={project.featured ? 'margin-top: 1rem; font-size: 1.1rem;' : 'margin-top: 1rem;'}>{project.description}</p>
				</a>
			))}
		</main>

		<!-- 3. 最新轨迹（构建时拉取，失败则降级为占位文案） -->
		<section class="tracks">
			<h2>最新轨迹</h2>
			{tracks.length > 0 ? (
				<ul>
					{tracks.map((track) => (
						<li>
							<a href={track.url} target="_blank" rel="noopener">{track.title}</a>
							{track.date && <time datetime={track.date}>{track.date}</time>}
						</li>
					))}
				</ul>
			) : (
				<p class="tracks-fallback">最新日志正在同步中...</p>
			)}
		</section>

		<!-- 4. 订阅入口 -->
		<section class="subscribe">
			<h2>订阅</h2>
			<a class="rss-btn" href="https://build.laity.work/rss.xml" target="_blank" rel="noopener">订阅所有动态 (RSS)</a>
		</section>

		<!-- 5. 页脚 -->
		<footer>
			<p>© 2026 Laity Studio. Built with AI.</p>
			<p style="margin-top: 0.5rem;">
				<a href="/about">关于</a> ·
				<a href="https://github.com/laity9527" target="_blank" rel="noopener">GitHub</a> ·
				<a href="mailto:hi@laity.work">Email</a>
			</p>
		</footer>

	</div>
</Base>

<style>
	/* 便当盒网格布局 */
	.grid {
		display: grid;
		grid-template-columns: repeat(1, 1fr);
		gap: 1.5rem;
	}
	@media (min-width: 768px) {
		.grid { grid-template-columns: repeat(3, 1fr); }
		.col-span-2 { grid-column: span 2; }
	}

	/* 卡片基础样式 */
	.card {
		background-color: #18181b;
		border: 1px solid #27272a;
		border-radius: 1rem;
		padding: 2rem;
		text-decoration: none;
		color: inherit;
		transition: all 0.2s ease;
		display: flex;
		flex-direction: column;
		position: relative;
		overflow: hidden;
	}
	.card:hover {
		border-color: #52525b;
		transform: translateY(-2px);
		background-color: #1f1f23;
	}
	.card h3 { font-size: 1.5rem; margin-bottom: 0.5rem; display: flex; align-items: center; gap: 0.5rem; }
	.card p { color: #a1a1aa; font-size: 0.95rem; flex-grow: 1; }

	/* 状态标签 */
	.tag {
		font-size: 0.75rem;
		padding: 0.2rem 0.6rem;
		border-radius: 1rem;
		font-weight: 600;
		text-transform: uppercase;
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
	}
	.tag-live { background-color: rgba(52, 211, 153, 0.1); color: #34d399; border: 1px solid #065f46; }
	.tag-wip { background-color: rgba(251, 191, 36, 0.1); color: #fbbf24; border: 1px solid #92400e; }

	/* 状态标签呼吸灯 */
	.dot {
		width: 0.45rem;
		height: 0.45rem;
		border-radius: 50%;
		flex-shrink: 0;
		animation: breathe 2s ease-in-out infinite;
	}
	.tag-live .dot { background-color: #34d399; --halo: rgba(52, 211, 153, 0.6); }
	.tag-wip .dot { background-color: #fbbf24; --halo: rgba(251, 191, 36, 0.6); }
	@keyframes breathe {
		0%, 100% { opacity: 1; box-shadow: 0 0 0 0 var(--halo); }
		50% { opacity: 0.45; box-shadow: 0 0 0 4px rgba(0, 0, 0, 0); }
	}

	/* 特别强调的卡片 */
	.card-main {
		background: linear-gradient(135deg, #18181b 0%, #27272a 100%);
		border-color: #3f3f46;
	}
	.card-main h3 { color: #fbbf24; }

	/* 最新轨迹 */
	.tracks { margin-top: 4rem; }
	.tracks h2, .subscribe h2 { font-size: 0.85rem; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: #52525b; margin-bottom: 0.5rem; }
	.tracks ul { list-style: none; }
	.tracks li { display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; padding: 0.85rem 0; border-bottom: 1px solid #27272a; }
	.tracks li a { color: #f4f4f5; text-decoration: none; transition: color 0.2s ease; }
	.tracks li a:hover { color: #fbbf24; }
	.tracks time { color: #52525b; font-size: 0.8rem; font-variant-numeric: tabular-nums; white-space: nowrap; }
	.tracks-fallback { color: #52525b; font-size: 0.9rem; padding: 0.85rem 0; }

	/* 订阅入口 */
	.subscribe { margin-top: 3rem; }
	.rss-btn {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.65rem 1.4rem;
		background-color: #18181b;
		border: 1px solid #3f3f46;
		border-radius: 1rem;
		color: #fbbf24;
		font-size: 0.9rem;
		font-weight: 600;
		text-decoration: none;
		transition: all 0.2s ease;
	}
	.rss-btn:hover {
		border-color: #52525b;
		transform: translateY(-2px);
		background-color: #1f1f23;
	}
</style>
