---
// Laity 主站
import BaseLayout from '../layouts/BaseLayout.astro';
import projects from '../data/projects.json';

const statusLabel: Record<string, string> = { live: 'LIVE', wip: 'WIP' };
const isExternalUrl = (url: string) => /^https?:\/\//.test(url);
const padded = (n: number) => String(n).padStart(2, '0');

const products = projects.filter((project) => project.isFeatured);
const activeProjects = products.filter((project) => project.status === 'live').length;

const siteUrl = (Astro.site ?? new URL('https://laity.work')).href.replace(/\/$/, '');
const jsonLd = {
	'@context': 'https://schema.org',
	'@type': 'Organization',
	name: 'Laity',
	alternateName: 'Laity Studio',
	url: siteUrl,
	logo: `${siteUrl}/apple-touch-icon.png`,
	description: 'Laity 是一家独立开发厂牌：用 AI 与现代 Web 技术把想法做成上线产品，并公开每个判断的 BEFORE 与 AFTER。',
	sameAs: ['https://github.com/laity9527', 'https://build.laity.work'],
};
---

<BaseLayout
	title="Laity｜独立开发厂牌 · 把判断做成产品"
	description="Laity 是一家独立开发厂牌：用 AI 与现代 Web 技术把想法做成上线产品，并把每个决定的 BEFORE 与 AFTER 公开记录在前后志。"
	jsonLd={jsonLd}
>
	<div class="container">
		<main id="main">

		<!-- 1. Hero -->
		<section class="hero">
			<h1>把判断做成产品。</h1>
			<p class="lede">Laity 是一家独立开发厂牌。我们用 AI 与现代 Web 技术，把想法做成能上线的产品，并把每个决定的 BEFORE 与 AFTER 公开记录在前后志。</p>
			<div class="cta">
				<a class="btn-primary" href="https://build.laity.work" target="_blank" rel="noopener">进入前后志 ↗</a>
				<a class="btn-ghost" href="#products">Explore Products</a>
			</div>
		</section>

		<!-- 2. 数据背书 -->
		<dl class="stats">
			<div class="stat">
				<dt>ACTIVE PROJECTS</dt>
				<dd>{padded(activeProjects)}</dd>
			</div>
			<div class="stat">
				<dt>CURRENT FOCUS</dt>
				<dd>前后志</dd>
			</div>
		</dl>

		<!-- 3. 项目矩阵 -->
		<section id="products" class="products">
			<h2 class="section-label">Systems &amp; Products</h2>
			<ul class="product-list">
				{products.map((project) => (
					<li>
						<a
							class:list={['product', !isExternalUrl(project.url) && 'is-static']}
							href={isExternalUrl(project.url) ? project.url : undefined}
							target={isExternalUrl(project.url) ? '_blank' : undefined}
							rel={isExternalUrl(project.url) ? 'noopener' : undefined}
						>
							<div class="product-main">
								<h3>{project.title}</h3>
								<p>{project.description}</p>
							</div>
							<div class="product-meta">
								{project.stack.length > 0 && <span class="stack">{project.stack.join(' / ')}</span>}
								<span class={`status status-${project.status}`}>
									<span class="dot" aria-hidden="true"></span>{statusLabel[project.status]}
								</span>
							</div>
							<span class="go" aria-hidden="true">→</span>
						</a>
					</li>
				))}
			</ul>
		</section>

		<!-- 4. 方法论 -->
		<section class="philosophy">
			<h2 class="section-label">Our Philosophy</h2>
			<div class="tenets">
				<p><span class="num">01.</span>不囤想法，直接上线。</p>
				<p><span class="num">02.</span>公开记录判断，用事实复盘。</p>
				<p><span class="num">03.</span>接受反驳，判断才站得住。</p>
			</div>
		</section>

		</main>
	</div>
</BaseLayout>

<style>
	/* Hero：占视口 70%，标题背后一层极暗光晕 */
	.hero {
		position: relative;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		min-height: 70vh;
		padding: 4rem 0;
		margin: 0 0 4rem;
		text-align: center;
	}
	.hero::before {
		content: '';
		position: absolute;
		inset: 0;
		z-index: -1;
		pointer-events: none;
		background: radial-gradient(34rem 22rem at 50% 45%, rgba(255, 255, 255, 0.055), rgba(0, 0, 0, 0) 70%);
	}
	.hero h1 {
		color: var(--fg-bright);
		font-size: clamp(3.5rem, 6vw, 5rem);
		font-weight: 700;
		line-height: 1.04;
		letter-spacing: -0.04em;
	}
	.lede {
		max-width: 42rem;
		margin-top: 1.5rem;
		color: var(--muted);
		font-size: 1.0625rem;
		line-height: 1.75;
	}
	.cta {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0.75rem;
		margin-top: 2.5rem;
	}
	.btn-primary,
	.btn-ghost {
		display: inline-flex;
		align-items: center;
		height: 3rem;
		padding: 0 1.5rem;
		border-radius: 8px;
		font-size: 0.9375rem;
		font-weight: 600;
		text-decoration: none;
		transition: background-color 0.15s ease, border-color 0.15s ease, color 0.15s ease;
	}
	.btn-primary { background-color: var(--fg-bright); color: var(--bg); }
	.btn-ghost { border: 1px solid var(--line-strong); color: var(--fg); }
	@media (hover: hover) {
		.btn-primary:hover { background-color: #d9d9d9; }
		.btn-ghost:hover { border-color: var(--line-hover); background-color: rgba(255, 255, 255, 0.04); }
	}

	/* 数据背书：等宽字体 + 极细竖线分隔 */
	.stats {
		display: flex;
		justify-content: center;
		align-items: center;
		gap: 2.5rem;
		margin-bottom: var(--section);
	}
	.stat {
		display: flex;
		align-items: baseline;
		gap: 0.5rem;
		font-family: var(--mono);
		font-size: 0.8125rem;
		white-space: nowrap;
	}
	.stat dt { color: var(--dim); letter-spacing: 0.06em; }
	.stat dt::after { content: ':'; }
	.stat dd { color: var(--fg); font-variant-numeric: tabular-nums; }
	.stat + .stat { border-left: 1px solid var(--line); padding-left: 2.5rem; }

	/* 区块标题 */
	.section-label {
		font-family: var(--mono);
		font-size: 0.75rem;
		font-weight: 500;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--dim);
	}

	/* 项目矩阵：全宽垂直列表 */
	.products { margin-bottom: var(--section); }
	.products .section-label { margin-bottom: 2rem; }
	.product-list { list-style: none; border-top: 1px solid var(--line); }
	.product-list li { border-bottom: 1px solid var(--line); }
	.product {
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto 2rem;
		align-items: center;
		gap: 2rem;
		margin: 0 -1.5rem;
		padding: 2rem 1.5rem;
		color: inherit;
		text-decoration: none;
		transition: background-color 0.2s ease;
	}
	.product.is-static { cursor: default; }
	.product.is-static .go { display: none; }
	@media (hover: hover) {
		.product:not(.is-static):hover { background-color: rgba(255, 255, 255, 0.025); }
	}
	.product-main h3 {
		font-size: 1.5rem;
		font-weight: 700;
		letter-spacing: -0.02em;
		color: var(--fg-bright);
	}
	.product-main p {
		max-width: 60ch;
		margin-top: 0.5rem;
		color: var(--muted);
		font-size: 0.9375rem;
		line-height: 1.7;
	}
	.product-meta {
		display: flex;
		align-items: center;
		gap: 1.5rem;
		font-family: var(--mono);
		font-size: 0.75rem;
		white-space: nowrap;
	}
	.stack { color: var(--dim); letter-spacing: 0.02em; }
	.status { display: inline-flex; align-items: center; gap: 0.4rem; letter-spacing: 0.08em; }
	.status-live { color: var(--live); }
	.status-wip { color: var(--accent); }
	.dot { width: 6px; height: 6px; border-radius: 50%; background-color: currentColor; flex-shrink: 0; }
	.go {
		justify-self: end;
		color: var(--accent);
		font-size: 1.0625rem;
		opacity: 0;
		transform: translateX(-4px);
		transition: opacity 0.2s ease, transform 0.2s ease;
	}
	.product:focus-visible .go { opacity: 1; transform: none; }
	@media (hover: hover) {
		.product:not(.is-static):hover .go { opacity: 1; transform: none; }
	}

	/* 方法论：左窄右宽 */
	.philosophy {
		display: grid;
		gap: 2rem;
		padding-top: 4rem;
		border-top: 1px solid var(--line);
	}
	.tenets { display: grid; gap: 1.5rem; }
	.tenets p {
		font-size: clamp(1.5rem, 3vw, 2.25rem);
		font-weight: 600;
		line-height: 1.35;
		letter-spacing: -0.02em;
		color: var(--fg);
	}
	.num { margin-right: 0.75rem; color: var(--accent); font-family: var(--mono); }

	@media (min-width: 768px) {
		.philosophy { grid-template-columns: 1fr 2fr; gap: 4rem; }
	}

	@media (max-width: 720px) {
		.hero { min-height: 70vh; padding: 3rem 0; margin-bottom: 2rem; }
		.hero h1 { font-size: 2.75rem; }
		.lede { font-size: 1rem; margin-top: 1rem; }
		.cta { margin-top: 2rem; }

		/* 指标：竖排，分隔线改为横线 */
		.stats { flex-direction: column; align-items: stretch; gap: 0; margin-bottom: 5rem; }
		.stat { justify-content: space-between; padding: 0.75rem 0; }
		.stat + .stat { border-left: 0; border-top: 1px solid var(--line); padding-left: 0; }

		/* 项目行：上下堆叠，箭头常显 */
		.product {
			grid-template-columns: 1fr auto;
			grid-template-areas:
				'main go'
				'meta meta';
			gap: 1rem;
			margin: 0 -1rem;
			padding: 1.5rem 1rem;
		}
		.product-main { grid-area: main; }
		.product-meta { grid-area: meta; gap: 1rem; }
		.product-main h3 { font-size: 1.25rem; }
		.go { grid-area: go; align-self: start; opacity: 1; transform: none; }
		.philosophy { gap: 1.5rem; padding-top: 3rem; }
	}
</style>
