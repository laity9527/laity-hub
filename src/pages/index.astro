---
// Laity 主站
---

<!DOCTYPE html>
<html lang="zh-CN">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>Laity Studio | 外行造世界</title>
		<style>
			/* 基础重置与全局样式 */
			* { box-sizing: border-box; margin: 0; padding: 0; }
			body {
				background-color: #0a0a0a;
				color: #f4f4f5;
				font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
				line-height: 1.6;
				padding: 2rem 1rem;
				display: flex;
				justify-content: center;
			}
			.container { max-width: 1000px; width: 100%; }
			
			/* 头部区 */
			header { margin-bottom: 4rem; margin-top: 4rem; text-align: center; }
			h1 { font-size: 3.5rem; font-weight: 800; letter-spacing: -0.05em; margin-bottom: 1rem; }
			.highlight { color: #fbbf24; }
			.subtitle { font-size: 1.25rem; color: #a1a1aa; max-width: 600px; margin: 0 auto; }

			/* 便当盒网格布局 */
			.grid {
				display: grid;
				grid-template-columns: repeat(1, 1fr);
				gap: 1.5rem;
			}
			@media (min-width: 768px) {
				.grid { grid-template-columns: repeat(3, 1fr); }
				.col-span-2 { grid-column: span 2; }
			}

			/* 卡片基础样式 */
			.card {
				background-color: #18181b;
				border: 1px solid #27272a;
				border-radius: 1rem;
				padding: 2rem;
				text-decoration: none;
				color: inherit;
				transition: all 0.2s ease;
				display: flex;
				flex-direction: column;
				position: relative;
				overflow: hidden;
			}
			.card:hover {
				border-color: #52525b;
				transform: translateY(-2px);
				background-color: #1f1f23;
			}
			.card h3 { font-size: 1.5rem; margin-bottom: 0.5rem; display: flex; align-items: center; gap: 0.5rem; }
			.card p { color: #a1a1aa; font-size: 0.95rem; flex-grow: 1; }
			
			/* 状态标签 */
			.tag {
				font-size: 0.75rem;
				padding: 0.2rem 0.6rem;
				border-radius: 1rem;
				font-weight: 600;
				text-transform: uppercase;
			}
			.tag-live { background-color: rgba(52, 211, 153, 0.1); color: #34d399; border: 1px solid #065f46; }
			.tag-wip { background-color: rgba(251, 191, 36, 0.1); color: #fbbf24; border: 1px solid #92400e; }

			/* 特别强调的卡片 */
			.card-main {
				background: linear-gradient(135deg, #18181b 0%, #27272a 100%);
				border-color: #3f3f46;
			}
			.card-main h3 { color: #fbbf24; }

			/* 页脚 */
			footer { margin-top: 5rem; text-align: center; color: #52525b; font-size: 0.875rem; padding-top: 2rem; border-top: 1px solid #27272a; }
			footer a { color: #a1a1aa; text-decoration: none; }
			footer a:hover { color: #f4f4f5; }
		</style>
	</head>
	<body>
		<div class="container">
			
			<!-- 1. 头部区 -->
			<header>
				<h1>Laity<span class="highlight">.</span></h1>
				<p class="subtitle">我是外行，但我用 AI 构建世界。<br>不囤想法，直接上线。</p>
			</header>

			<!-- 2. 项目矩阵区 -->
			<main class="grid">
				
				<!-- 核心项目：前后志 (占两列) -->
				<a href="https://build.laity.work" class="card col-span-2 card-main" target="_blank">
					<div style="display: flex; justify-content: space-between; align-items: start;">
						<h3>📓 前后志</h3>
						<span class="tag tag-live">Live</span>
					</div>
					<p style="margin-top: 1rem; font-size: 1.1rem;">一个公开的判断轨迹站。记录每个作品从想法到上线的 BEFORE 与 AFTER 开发日志。</p>
				</a>

				<!-- 系统项目：地球 Online -->
				<a href="#" class="card" target="_blank">
					<div style="display: flex; justify-content: space-between; align-items: start;">
						<h3>🌍 地球 Online</h3>
						<span class="tag tag-wip">WIP</span>
					</div>
					<p style="margin-top: 1rem;">真人镜像版系统。</p>
				</a>

				<!-- 工具矩阵 1 -->
				<a href="#" class="card" target="_blank">
					<div style="display: flex; justify-content: space-between; align-items: start;">
						<h3>🌿 药都安</h3>
						<span class="tag tag-live">Live</span>
					</div>
					<p style="margin-top: 1rem;">中药材溯源与辅助工具。</p>
				</a>

				<!-- 工具矩阵 2 -->
				<a href="#" class="card" target="_blank">
					<div style="display: flex; justify-content: space-between; align-items: start;">
						<h3>⚔️ 三国萌主</h3>
						<span class="tag tag-live">Live</span>
					</div>
					<p style="margin-top: 1rem;">休闲策略小程序。</p>
				</a>

				<!-- 工具矩阵 3 -->
				<a href="#" class="card" target="_blank">
					<div style="display: flex; justify-content: space-between; align-items: start;">
						<h3>🧠 SBTI测试</h3>
						<span class="tag tag-live">Live</span>
					</div>
					<p style="margin-top: 1rem;">基于性格的行为倾向测试。</p>
				</a>

			</main>

			<!-- 3. 页脚 -->
			<footer>
				<p>© 2026 Laity Studio. Built with AI.</p>
				<p style="margin-top: 0.5rem;">
					<a href="https://github.com/laity9527" target="_blank">GitHub</a> · 
					<a href="mailto:hi@laity.work">Email</a>
				</p>
			</footer>

		</div>
	</body>
</html>