---
import Footer from '../components/Footer.astro';

interface Props {
	title?: string;
	description?: string;
	/** 社交分享图路径，默认品牌 OG 图 */
	image?: string;
	/** 结构化数据（如 Organization） */
	jsonLd?: Record<string, unknown>;
	/** 单屏居中页（如 404）：整列垂直居中 */
	centered?: boolean;
	/** 不收录（如 404） */
	noindex?: boolean;
}

const {
	title = 'Laity | 独立开发厂牌',
	description = 'Laity 是一家独立开发厂牌。在 AI 时代，判断力比代码更珍贵。',
	image = '/og/og-default.png',
	jsonLd,
	centered = false,
	noindex = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin).href;
const imageUrl = new URL(image, Astro.site ?? Astro.url.origin).href;

const normalize = (p: string) => p.replace(/index$/, '').replace(/\/+$/, '') || '/';
const currentPath = normalize(Astro.url.pathname);
const isCurrent = (target: string) => currentPath === normalize(target);
---

<!DOCTYPE html>
<html lang="zh-CN">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonical} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonical} />
		<meta property="og:locale" content="zh_CN" />
		<meta property="og:site_name" content="Laity" />
		<meta property="og:image" content={imageUrl} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content="Laity · 把判断做成产品" />
		<meta property="og:image:type" content="image/png" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={imageUrl} />
		<meta name="twitter:image:alt" content="Laity · 把判断做成产品" />
		<meta name="theme-color" content="#0a0a0a" />
		<meta name="color-scheme" content="dark" />
		<meta name="robots" content={noindex ? 'noindex' : 'max-image-preview:large'} />
		{jsonLd && <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />}
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" sizes="32x32" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<link rel="mask-icon" href="/mask-icon.svg" color="#fbbf24" />
		<link rel="manifest" href="/manifest.webmanifest" />
		<link rel="preconnect" href="https://build.laity.work" />
		<link rel="dns-prefetch" href="https://build.laity.work" />
	</head>
	<body class:list={[centered && 'centered']}>
		<a class="skip-link" href="#main">跳到主要内容</a>
		<div class="bg-grid" aria-hidden="true"></div>

		<header class="site-nav">
			<div class="nav-inner">
				<a class="logo" href="/">Laity<span class="highlight">.</span></a>
				<nav class="nav-links" aria-label="主导航">
					<a href="/#products" aria-current={isCurrent('/') ? 'page' : undefined}>Products</a>
					<a href="/about" aria-current={isCurrent('/about') ? 'page' : undefined}>About</a>
					<a href="https://build.laity.work" target="_blank" rel="noopener">前后志 ↗</a>
					<a href="https://github.com/laity9527" target="_blank" rel="noopener me">GitHub ↗</a>
				</nav>
			</div>
		</header>

		<slot />

		<Footer />
	</body>
</html>

<style is:global>
	:root {
		color-scheme: dark;
		--bg: #0a0a0a;
		--line: #1f1f1f;
		--line-strong: #2e2e2e;
		--line-hover: rgba(255, 255, 255, 0.22);
		--fg: #ededed;
		--fg-bright: #ffffff;
		--muted: #888888;
		/* 12–13px 的辅助标签也要过 AA（在 #0a0a0a 上约 4.6:1） */
		--dim: #7a7a7a;
		--accent: #fbbf24;
		--live: #34d399;
		--shell: 1120px;
		--pad: 1.5rem;
		/* 区块之间的固定节奏（8px 的整数倍） */
		--section: 8rem;
		--mono: ui-monospace, SFMono-Regular, "SF Mono", Menlo, Consolas, "Liberation Mono", monospace;
	}

	* { box-sizing: border-box; margin: 0; padding: 0; }
	html {
		scroll-behavior: smooth;
		scroll-padding-top: 5rem;
		background-color: var(--bg);
		/* 中心略亮、四周暗的极弱径向渐变 */
		background-image: radial-gradient(60rem 36rem at 50% 0%, rgba(255, 255, 255, 0.045), rgba(10, 10, 10, 0) 68%);
		background-repeat: no-repeat;
		background-attachment: fixed;
	}
	body {
		color: var(--fg);
		font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
		line-height: 1.6;
		background-color: transparent;
		padding-bottom: 4rem;
	}
	body.centered {
		min-height: 100vh;
		display: flex;
		flex-direction: column;
	}
	body.centered .container { margin-top: auto; margin-bottom: auto; }

	/* 固定不随滚动的像素网格，向下渐隐 */
	.bg-grid {
		position: fixed;
		inset: 0;
		z-index: 0;
		pointer-events: none;
		background-image:
			linear-gradient(to right, rgba(255, 255, 255, 0.02) 1px, rgba(0, 0, 0, 0) 1px),
			linear-gradient(to bottom, rgba(255, 255, 255, 0.02) 1px, rgba(0, 0, 0, 0) 1px);
		background-size: 32px 32px;
		mask-image: radial-gradient(80rem 50rem at 50% 0%, #000 30%, rgba(0, 0, 0, 0) 75%);
		-webkit-mask-image: radial-gradient(80rem 50rem at 50% 0%, #000 30%, rgba(0, 0, 0, 0) 75%);
	}

	.container {
		position: relative;
		z-index: 1;
		width: 100%;
		max-width: var(--shell);
		margin: 0 auto;
		padding: 0 var(--pad);
	}

	/* 吸顶毛玻璃导航 */
	.site-nav {
		position: sticky;
		top: 0;
		z-index: 50;
		width: 100%;
		background-color: rgba(10, 10, 10, 0.72);
		-webkit-backdrop-filter: blur(12px);
		backdrop-filter: blur(12px);
		border-bottom: 1px solid var(--line);
	}
	.nav-inner {
		position: relative;
		z-index: 1;
		width: 100%;
		max-width: var(--shell);
		margin: 0 auto;
		min-height: 4rem;
		padding: 1rem var(--pad);
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
	}
	.logo { font-size: 1.125rem; font-weight: 700; letter-spacing: -0.02em; color: var(--fg-bright); text-decoration: none; }
	.highlight { color: var(--accent); }
	.nav-links { display: flex; align-items: center; gap: 2rem; }
	.nav-links a { color: var(--muted); font-size: 0.875rem; text-decoration: none; transition: color 0.15s ease; }
	.nav-links a:hover { color: var(--fg-bright); }

	/* 二级页（About / 404）的页头 */
	header:not(.site-nav) { margin: 6rem 0 var(--section); text-align: center; }
	h1 { font-size: 3.5rem; font-weight: 700; letter-spacing: -0.04em; margin-bottom: 1rem; }
	.subtitle { font-size: 1.25rem; color: var(--muted); max-width: 600px; margin: 0 auto; }

	@media (max-width: 640px) {
		:root { --pad: 1.25rem; --section: 5rem; }
		h1 { font-size: 2.5rem; }
		.nav-links { gap: 1rem; }
		.nav-links a { font-size: 0.85rem; }
		header:not(.site-nav) { margin: 4rem 0 var(--section); }
	}
	@media (max-width: 350px) {
		.nav-links { gap: 0.5rem; }
		.nav-links a { font-size: 0.75rem; }
	}

	/* 键盘可达性 */
	/* 跳转链：平时移出视口，Tab 聚焦时才出现 */
	.skip-link {
		position: fixed;
		top: 0.75rem;
		left: 0.75rem;
		z-index: 60;
		padding: 0.5rem 1rem;
		border-radius: 8px;
		background-color: var(--fg-bright);
		color: var(--bg);
		font-size: 0.875rem;
		font-weight: 600;
		text-decoration: none;
		transform: translateY(-200%);
	}
	.skip-link:focus {
		transform: none;
	}
	a:focus-visible {
		outline: 2px solid rgba(251, 191, 36, 0.75);
		outline-offset: 3px;
		border-radius: 4px;
	}

	/* 尊重系统的「减少动态效果」 */
	@media (prefers-reduced-motion: reduce) {
		html { scroll-behavior: auto; }
		*, *::before, *::after {
			animation-duration: 0.001ms !important;
			animation-iteration-count: 1 !important;
			transition-duration: 0.001ms !important;
		}
	}
</style>
