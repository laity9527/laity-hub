---
import Footer from '../components/Footer.astro';

interface Props {
	title?: string;
	description?: string;
	/** 单屏居中页（如 404）：整列垂直居中 */
	centered?: boolean;
}

const {
	title = 'Laity | 独立开发厂牌',
	description = '外行造世界。用 AI 构建项目矩阵。',
	centered = false,
} = Astro.props;
---

<!DOCTYPE html>
<html lang="zh-CN">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="website" />
		<link
			rel="alternate"
			type="application/rss+xml"
			title="前后志 · 判断轨迹"
			href="https://build.laity.work/rss.xml"
		/>
	</head>
	<body class:list={[centered && 'centered']}>
		<div class="bg-grid" aria-hidden="true"></div>

		<nav>
			<div class="nav-inner">
				<a class="logo" href="/">Laity<span class="highlight">.</span></a>
				<div class="nav-links">
					<a href="/#projects">Projects</a>
					<a href="/about">About</a>
					<a href="https://github.com/laity9527" target="_blank" rel="noopener">GitHub</a>
				</div>
			</div>
		</nav>

		<slot />

		<Footer />
	</body>
</html>

<style is:global>
	:root {
		--bg: #09090b;
		--surface: #121212;
		--surface-hover: #1a1a1d;
		--line: #27272a;
		--line-strong: #3f3f46;
		/* 悬停边框改用半透明白，比琥珀更克制 */
		--line-hover: rgba(255, 255, 255, 0.26);
		--fg: #ededed;
		--fg-bright: #ffffff;
		--muted: #a1a1aa;
		--dim: #71717a;
		--accent: #fbbf24;
		--live: #34d399;
		--shell: 1120px;
		--pad: 1.5rem;
		--rhythm: 8rem;
	}

	/* 基础重置与全局样式 */
	* { box-sizing: border-box; margin: 0; padding: 0; }
	html { scroll-behavior: smooth; background-color: var(--bg); }
	body {
		color: var(--fg);
		font-family: ui-sans-serif, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
		line-height: 1.6;
		background-color: transparent;
		padding-bottom: 4rem;
	}
	body.centered {
		min-height: 100vh;
		display: flex;
		flex-direction: column;
	}
	body.centered .container { margin-top: auto; margin-bottom: auto; }

	/* 科技感网格底纹：固定不随滚动，用遮罩自上而下渐隐 */
	.bg-grid {
		position: fixed;
		inset: 0;
		z-index: 0;
		pointer-events: none;
		background-image:
			linear-gradient(to right, rgba(255, 255, 255, 0.03) 1px, rgba(0, 0, 0, 0) 1px),
			linear-gradient(to bottom, rgba(255, 255, 255, 0.03) 1px, rgba(0, 0, 0, 0) 1px);
		background-size: 64px 64px;
		mask-image: radial-gradient(90rem 55rem at 50% -8%, #000 35%, rgba(0, 0, 0, 0) 78%);
		-webkit-mask-image: radial-gradient(90rem 55rem at 50% -8%, #000 35%, rgba(0, 0, 0, 0) 78%);
	}

	.container {
		position: relative;
		z-index: 1;
		width: 100%;
		max-width: var(--shell);
		margin: 0 auto;
		padding: 0 var(--pad);
	}

	/* 吸顶导航：毛玻璃 + 拉满宽度 */
	nav {
		position: sticky;
		top: 0;
		z-index: 50;
		width: 100%;
		background-color: rgba(9, 9, 11, 0.72);
		-webkit-backdrop-filter: blur(12px);
		backdrop-filter: blur(12px);
		border-bottom: 1px solid var(--line);
	}
	.nav-inner {
		position: relative;
		z-index: 1;
		width: 100%;
		max-width: var(--shell);
		margin: 0 auto;
		padding: 1.25rem var(--pad);
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
	}
	.logo { font-size: 1.15rem; font-weight: 700; letter-spacing: -0.02em; color: var(--fg-bright); text-decoration: none; }
	.nav-links { display: flex; align-items: center; gap: 1.75rem; }
	.nav-links a { color: var(--muted); font-size: 0.9rem; text-decoration: none; transition: color 0.2s ease; }
	.nav-links a:hover { color: var(--fg-bright); }

	/* 页头区 */
	header { margin: 6rem 0 var(--rhythm); text-align: center; }
	h1 { font-size: 3.5rem; font-weight: 800; letter-spacing: -0.04em; margin-bottom: 1rem; }
	.highlight { color: var(--accent); }
	.subtitle { font-size: 1.25rem; color: var(--muted); max-width: 600px; margin: 0 auto; }

	@media (max-width: 640px) {
		:root { --pad: 1.25rem; }
		h1 { font-size: 2.5rem; }
		.nav-inner { padding: 1rem var(--pad); }
		.nav-links { gap: 1.25rem; }
		.nav-links a { font-size: 0.85rem; }
		header { margin: 4rem 0 5rem; }
	}

	/* 键盘可达性：只用焦点环，不影响鼠标交互 */
	a:focus-visible, .card:focus-visible {
		outline: 2px solid rgba(251, 191, 36, 0.75);
		outline-offset: 3px;
		border-radius: 0.4rem;
	}

	/* 尊重系统的「减少动态效果」：动画收敛到终态，内容不会停在不可见状态 */
	@media (prefers-reduced-motion: reduce) {
		html { scroll-behavior: auto; }
		*, *::before, *::after {
			animation-duration: 0.001ms !important;
			animation-iteration-count: 1 !important;
			transition-duration: 0.001ms !important;
		}
	}
</style>
